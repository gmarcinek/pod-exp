# ── Klucze API ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama ───────────────────────────────────────────────────────────────────
# Domyślnie kontener łączy się z Ollamą działającą na hoście.
# Jeśli Ollama działa w innym kontenerze/komputerze, zmień URL.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Opcjonalnie: stała lista modeli zamiast live-fetch z /api/tags
# OLLAMA_MODELS=llama3.2,qwen2.5

# ── Piper TTS ────────────────────────────────────────────────────────────────
# Te ścieżki są ustawione w Dockerfile i raczej nie wymagają zmiany.
# PIPER_EXECUTABLE=/opt/piper/piper
# PIPER_MODEL_DIR=/app/piper_models
PIPER_DEFAULT_MODEL=pl_PL-darkman-medium
